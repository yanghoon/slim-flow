S3_ENDPOINT=${S3_ENDPOINT:-http://minio:9000}
S3_ACCESS_KEY=${S3_ACCESS_KEY:-your-access-key}
S3_SECRET_KEY=${S3_SECRET_KEY:-your-secret-key}
S3_REGION=${S3_REGION:-us-east-1}
S3_BUCKET=${S3_BUCKET:-iceberg}
S3_PATH_STYLE_ACCESS=${S3_PATH_STYLE_ACCESS:-true}

ENV_LOG_LEVEL=${ENV_LOG_LEVEL:-INFO}

FLINK_PROPERTIES="
jobmanager.rpc.address: jobmanager
parallelism.default: 2        
# table.catalog-store.kind: file
# table.catalog-store.file.path: file:///opt/flink/conf/catalog
env.log.level: ${ENV_LOG_LEVEL}"
